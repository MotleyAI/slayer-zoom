specification {
  element system
  element node
  element bucket {
    #virtual
  }
  tag legacy
  tag virtual
}
model {
  python = system 'Backend (Python)' {
    api = node 'HTTP API' {
      metadata {
        package 'slayer_zoom.api'
      }
    }
    core = node 'Ladder domain' {
      metadata {
        package 'slayer_zoom.core'
      }
    }
    executor = node 'Query executor' {
      metadata {
        package 'slayer_zoom.executor'
      }
    }
    traces = node 'Ladder store' {
      metadata {
        package 'slayer_zoom.traces'
      }
    }

    api -> core
    api -> executor
    api -> traces
    executor -> core
    traces -> core
  }
  typescript = system 'Web (TypeScript)' {
    app = node 'App shell' {
      metadata {
        package 'src/app'
      }
    }
    state = node 'Answer state' {
      metadata {
        package 'src/state'
      }
    }
    panels = node 'Panel renderers' {
      metadata {
        package 'src/panels'
      }
    }
    slider = node 'Granularity slider' {
      metadata {
        package 'src/slider'
      }
    }

    app -> slider
    app -> state
    slider -> state
    slider -> panels
  }
}
