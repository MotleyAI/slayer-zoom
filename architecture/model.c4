specification {
  element system
  element node
  element bucket {
    #virtual
  }
  tag legacy
  tag virtual
}
model {
  python = system 'Backend (Python)' {
    agent = node 'Ladder agent' {
      metadata {
        package 'slayer_zoom.agent'
        specs ['agent']
      }
    }
    api = node 'HTTP API' {
      metadata {
        package 'slayer_zoom.api'
      }
    }
    narrator = node 'Level narrator' {
      metadata {
        package 'slayer_zoom.narrator'
        specs ['narration']
      }
    }
    catalog = node 'SLayer catalog' {
      metadata {
        package 'slayer_zoom.catalog'
      }
    }
    context = node 'Business context' {
      metadata {
        package 'slayer_zoom.context'
      }
    }
    core = node 'Ladder domain' {
      metadata {
        package 'slayer_zoom.core'
      }
    }
    executor = node 'Query executor' {
      metadata {
        package 'slayer_zoom.executor'
      }
    }
    traces = node 'Ladder store' {
      metadata {
        package 'slayer_zoom.traces'
      }
    }

    agent -> catalog
    agent -> context
    agent -> core
    agent -> executor
    agent -> traces
    api -> agent
    api -> core
    api -> executor
    api -> narrator
    api -> traces
    catalog -> core
    executor -> core
    narrator -> core
    traces -> core
  }
  typescript = system 'Web (TypeScript)' {
    app = node 'App shell' {
      metadata {
        package 'src/app'
      }
    }
    state = node 'Answer state' {
      metadata {
        package 'src/state'
      }
    }
    panels = node 'Panel renderers' {
      metadata {
        package 'src/panels'
      }
    }
    slider = node 'Granularity slider' {
      metadata {
        package 'src/slider'
      }
    }

    app -> slider
    app -> state
    slider -> state
    slider -> panels
  }
}
